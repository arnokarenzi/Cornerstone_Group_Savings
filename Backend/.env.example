# CORNESTONE Co.LTD. backend local development configuration. Never commit backend/.env.
NODE_ENV=development
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=cornestone_app
DB_PASSWORD=replace-with-a-strong-database-password
DB_NAME=cornestone_online_db
DB_CONNECTION_LIMIT=10
# Local MariaDB may use false. Production requires true with server certificate validation.
DB_SSL_ENABLED=false
# For managed databases that provide a private CA, set ONE of these in the host dashboard.
# DB_SSL_CA=/path/to/provider-ca.pem
# DB_SSL_CA_BASE64=BASE64_ENCODED_PEM_CA_CERTIFICATE
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
# Exact origins only; no paths. In production, list the deployed frontend origin(s).
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# HttpOnly browser session cookie. Production requires Secure=true.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=Lax
# Always set this explicitly in production to match the real hosting topology:
# 0 for direct connections, 1 for exactly one trusted reverse proxy/load balancer.
TRUST_PROXY_HOPS=0

# Email delivery: console mode is local-development only. Hosted production uses the Resend HTTPS API.
EMAIL_PROVIDER=console
RESEND_API_KEY=
# In production, use a sender address on a domain verified with Resend.
EMAIL_FROM=CORNESTONE Co.LTD. <no-reply@example.com>
# Must be the frontend origin with no trailing application path. Use HTTPS in production.
PUBLIC_APP_URL=http://localhost:5173
